<?xml version="1.0" encoding="UTF-8"?>
<!-- IIS front for QENIVO with Windows Authentication. Steps and the matching QENIVO command
     line are in docs/DEPLOYMENT.md, section 3b. Needs URL Rewrite and Application Request Routing
     (proxy enabled), Windows Authentication on, Anonymous Authentication off, and
     HTTP_X_REMOTE_USER allowed as a server variable. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="qenivo" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_REMOTE_USER" value="{LOGON_USER}" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8765/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="536870912" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
